# Line ends (#173): every text file is stored and checked out with LF, on
# every platform and whatever core.autocrlf says, so that a fresh clone and
# the Windows CI runner have the bytes a tool wrote. A test that needs CRLF
# builds its CRLF variant in code; it never relies on the checkout.
* text=auto eol=lf

# cmd.exe misreads LF batch files (labels, goto): these keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

